<Window x:Class="CybersecurityChatbotGUI.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberShield Task Assistant" Height="650" Width="550"
        Background="#070A0E" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="TerminalInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0D131C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="🛠️ TARGET OBJECTIVE (TASK TITLE):" Foreground="#00FF41" FontFamily="Courier New" FontWeight="Bold"/>
                <TextBox x:Name="txtTaskTitle" Style="{StaticResource TerminalInputStyle}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel>
                <TextBlock Text="📝 MITIGATION PROTOCOLS (DESCRIPTION):" Foreground="#00FF41" FontFamily="Courier New" FontWeight="Bold"/>
                <TextBox x:Name="txtTaskDescription" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource TerminalInputStyle}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel>
                <TextBlock Text="⏰ REMINDER INTERVAL / METRIC NOTE:" Foreground="#00FF41" FontFamily="Courier New" FontWeight="Bold"/>
                <TextBox x:Name="txtReminder" Style="{StaticResource TerminalInputStyle}"/>
            </StackPanel>
        </Grid>

        <Button x:Name="btnAddTask" 
                Grid.Row="3" 
                Content="➕ INITIALIZE CYBERSECURITY OBJECTIVE" 
                Background="#111822" Foreground="#00FF41" BorderBrush="#00FF41" BorderThickness="1"
                FontFamily="Courier New" FontWeight="Bold" Padding="12" Margin="0,5,0,20"
                Click="btnAddTask_Click"/>

        <Border Grid.Row="4" Background="#0D131C" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="4" Padding="5">
            <ListBox x:Name="lstTasks" Background="Transparent" BorderThickness="0" Foreground="White" FontFamily="Courier New">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="8" Margin="0,0,0,5" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="#00FF41" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Description}" Foreground="#C9D1D7" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                <WrapPanel>
                                    <TextBlock Text="⏱️ Reminder: " Foreground="#888888" FontSize="11"/>
                                    <TextBlock Text="{Binding Reminder}" Foreground="#FFB86C" FontSize="11" FontWeight="Bold" Margin="0,0,15,0"/>
                                    <TextBlock Text="|  Status: " Foreground="#888888" FontSize="11"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="5" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnMarkComplete" 
                    Grid.Column="0" 
                    Content="☑️ RESOLVE OBJECTIVE" 
                    Background="#111822" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1"
                    FontFamily="Courier New" FontWeight="Bold" Padding="10" Margin="0,0,10,0"
                    Click="btnMarkComplete_Click"/>

            <Button x:Name="btnDeleteTask" 
                    Grid.Column="1" 
                    Content="🗑️ PURGE LOG DATA" 
                    Background="#111822" Foreground="#FF5555" BorderBrush="#FF5555" BorderThickness="1"
                    FontFamily="Courier New" FontWeight="Bold" Padding="10"
                    Click="btnDeleteTask_Click"/>
        </Grid>
    </Grid>
</Window>