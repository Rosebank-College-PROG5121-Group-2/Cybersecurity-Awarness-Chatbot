<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberShield - Security Command Center"
        Height="750" Width="1050"
        Background="#070A0E" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="TerminalButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#111822"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00FF41"/>
                    <Setter Property="Foreground" Value="#070A0E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER SECTION ==================== -->
        <Border Grid.Row="0" Background="#0D131C" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Foreground="#00FF41"
                           FontFamily="Courier New"
                           FontSize="8.5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontWeight="Bold"
                           xml:space="preserve">
    ______          __                        ______   __        _         __        __   
  .' ___  |        [  |                     .' ____ \ [  |      (_)       [  |      |  ]  
 / .'   \_|  _   __ | |.--.   .---.  _ .--.| (___ \_| | |--.   __  .---.   | |  .--.| |  
 | |        [ \ [  ]| '/'`\ \/ /__\\[ `/'`\]_.____`.  | .-. | [  |/ /__\\  | |/ /'`\' |  
 \ `.___.'\  \ '/ / |  \__/ || \__., | |   | \____) | | | | |  | || \__.,  | || \__/  |  
  `.____ .'[\_:  / [__;.__.'  '.__.'[___]   \______.'[___]|__][___]'.__.'[___]'.__.;__]  
               \__.'</TextBlock>
                <TextBlock Text="| CYBERSECURITY COMMAND CENTRE // STATUS: ACTIVE |" 
                           Foreground="#888888" FontFamily="Courier New" FontSize="11" 
                           HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- ==================== MAIN SPLIT DECK ==================== -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT BOX: Chat Stream Area -->
            <Border Grid.Column="0" Background="#0D131C" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#111822" Padding="8" CornerRadius="4,4,0,0">
                        <TextBlock Text="📡 ENCRYPTED CHAT LOG" Foreground="#00FF41" FontFamily="Courier New" FontSize="12" FontWeight="Bold"/>
                    </Border>

                    <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel x:Name="ChatDisplay" Margin="0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT BOX: Status Control Panel Dashboard -->
            <Border Grid.Column="1" Background="#0D131C" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#111822" Padding="8" CornerRadius="4,4,0,0">
                        <TextBlock Text="🖥️ DIAGNOSTICS &amp; QUICK INTENTS" Foreground="#00FF41" FontFamily="Courier New" FontSize="12" FontWeight="Bold"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="15">
                        <StackPanel>
                            <TextBlock Text="FIREWALL STATUS: SECURE" Foreground="#00FF41" FontFamily="Courier New" FontSize="12" Margin="0,0,0,8" FontWeight="Bold"/>
                            <ProgressBar Value="100" Height="8" Background="#111822" Foreground="#00FF41" BorderThickness="0" Margin="0,0,0,15"/>

                            <TextBlock Text="SYSTEM THREAT LEVEL: MINIMAL" Foreground="#38BDF8" FontFamily="Courier New" FontSize="12" Margin="0,0,0,8" FontWeight="Bold"/>
                            <ProgressBar Value="12" Height="8" Background="#111822" Foreground="#38BDF8" BorderThickness="0" Margin="0,0,0,20"/>

                            <Separator Background="#1F2937" Margin="0,0,0,15"/>

                            <TextBlock Text="QUICK COMMAND CODES:" Foreground="#888888" FontFamily="Courier New" FontSize="11" Margin="0,0,0,10" FontWeight="Bold"/>
                            <TextBlock Text="• 'start quiz' - Test your skills" Foreground="#C9D1D7" FontFamily="Courier New" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="• 'menu' - View all security paths" Foreground="#C9D1D7" FontFamily="Courier New" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="• 'phishing' - Threat analysis" Foreground="#C9D1D7" FontFamily="Courier New" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="• 'password' - Check credential safety" Foreground="#C9D1D7" FontFamily="Courier New" FontSize="12" Margin="0,0,0,20"/>

                            <Border Background="#111822" BorderBrush="#1F2937" BorderThickness="1" Padding="10" CornerRadius="4">
                                <TextBlock Text="💡 Pro-Tip:\nType 'tell me more' after getting an answer to receive deep-dive security details!" 
                                           Foreground="#888888" FontFamily="Courier New" FontSize="11" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== INPUT BAR AREA ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TASKS ASSISTANT TRIGGER BUTTON -->
            <Button Content="TASKS ASSISTANT"
                    Grid.Column="0"
                    Style="{StaticResource TerminalButtonStyle}"
                    Click="btnTasks_Click"
                    Margin="0,0,10,0"/>

            <!-- AUDIT TRAIL LOG TRIGGER BUTTON -->
            <Button x:Name="btnViewLogs"
                    Content="📋 VIEW AUDIT TRAIL"
                    Grid.Column="1"
                    Style="{StaticResource TerminalButtonStyle}"
                    Click="btnViewLogs_Click"
                    Margin="0,0,10,0"/>

            <!-- MAIN TEXT INPUT CORE -->
            <TextBox x:Name="UserInput"
                     Grid.Column="2"
                     Background="#0D131C"
                     Foreground="White"
                     CaretBrush="#00FF41"
                     BorderBrush="#1F2937"
                     BorderThickness="1"
                     FontFamily="Courier New"
                     FontSize="14"
                     Padding="12,10"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"
                     KeyDown="UserInput_KeyDown"/>

            <!-- CONVERSATION TRANSMIT BUTTON -->
            <Button x:Name="SendButton"
                    Grid.Column="3"
                    Content="Send"
                    Style="{StaticResource TerminalButtonStyle}"
                    Padding="25,10"
                    Click="SendButton_Click"/>
            
        </Grid>
    </Grid>
</Window>