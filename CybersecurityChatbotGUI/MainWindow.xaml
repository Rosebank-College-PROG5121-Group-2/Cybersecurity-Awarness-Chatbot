<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberShield - Cybersecurity Awareness Assistant"
        Height="700" Width="900"
        Background="#0D1117">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="[ CYBERSECURITY COMMAND CENTER ]"
                   Foreground="#00FF41"
                   FontFamily="Courier New"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="10"/>

        <ScrollViewer x:Name="ChatScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChatDisplay" Margin="10"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UserInput"
                     Grid.Column="0"
                     Background="#21262D"
                     Foreground="White"
                     FontFamily="Courier New"
                     FontSize="13"
                     Padding="10,8"
                     Margin="0,0,10,0"
                     KeyDown="UserInput_KeyDown"/>
            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="SEND"
                    Background="#00FF41"
                    Foreground="#0D1117"
                    FontWeight="Bold"
                    Padding="20,8"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>